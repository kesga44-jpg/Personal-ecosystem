{
  "name": "personal-ecosystem",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:hub": "npm run dev -w @ecosystem/hub",
    "dev:sportapp": "npm run dev -w @ecosystem/sportapp",
    "dev:sidequest": "npm run dev -w @ecosystem/sidequest",
    "dev:ecosystem": "npm run dev -w @ecosystem/ecosystem",
    "build:hub": "npm run build -w @ecosystem/hub",
    "build:sportapp": "npm run build -w @ecosystem/sportapp",
    "build:sidequest": "npm run build -w @ecosystem/sidequest",
    "build:ecosystem": "npm run build -w @ecosystem/ecosystem",
    "build:all": "npm run build:hub && npm run build:sportapp && npm run build:sidequest && npm run build:ecosystem",
    "check:dist": "node packages/build-check/check-dist.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
