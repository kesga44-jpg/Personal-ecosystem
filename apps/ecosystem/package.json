{
  "name": "@ecosystem/ecosystem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5177",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4177",
    "build:vault": "tsc --noEmit && vite build --mode vault --outDir dist-vault",
    "preview:vault": "vite preview --outDir dist-vault --port 4178 --strictPort"
  },
  "dependencies": {
    "@ecosystem/core": "*",
    "@ecosystem/hub": "*",
    "@ecosystem/sidequest": "*",
    "@ecosystem/sportapp": "*",
    "@ecosystem/storage": "*",
    "@ecosystem/ui": "*",
    "fit-file-parser": "6.2.7",
    "leaflet": "1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.12"
  }
}
