{
  "name": "pe-hub",
  "compatibility_date": "2026-11-15",
  "preview_urls": false,
  // Worker alleen voor /api/* (doorgeefroute Open Food Facts); al het andere zijn statische bestanden.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
